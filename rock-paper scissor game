import random

print("Welcome to Rock-Paper-Scissors!\n")
print("Winning Rule:")
print("Rock vs Paper ->Paper wins")
print("Paper vs Scissor ->Scissor wins")
print("Rock vs Scissor -> Rock wins")
choices=["Rock","Paper","Scissor"]
while True:
    print("Choose an option:")
    print("1-Rock")
    print("2-Paper")
    print("3=Scissor")
    
    try:
        choice=int(input("ENTER YOUR CHOICE:"))
    except ValueError:
        print("Please enter a valid number.\n")
        continue
    while choice<1 or choice>3:
      try:
          choice=int (input("PLEASE ENTER A VALID CHOICE(1-3):"))
      except ValueError:
        continue
    user_choice=choices[choice-1]
    print("\nUser choice is:",user_choice)
    print("Now it's computer Turn...")
    
    comp_choice=random.randint(1,3)
    computer_choice=choices[comp_choice-1]
    
    print("Computer Choice is:",computer_choice)
    print(user_choice,"vs",computer_choice)
    if choice==comp_choice:
        print("*==It's Tie==*")
    elif( (choice==1 and comp_choice==3)or
         (choice==2 and comp_choice==1)or
         (choice==3 and comp_choice==2)) :
        print("*==User Wins==*")
    else:
        print("*==Computer Wins==*")  
        
    while True:
        ans=input("\n Do you want to play again?(YES/NO):").lower() 
        if ans in ['yes','no']:
            break
        print("Please enter YES or NO")
      
    if ans=="no":
       print("***THANKS FOR PLAYING**")
       break
